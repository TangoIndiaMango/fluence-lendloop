# LendLoop environment variables. Three places read them:
#   1. Next.js       -> .env.local      (npx convex dev writes the Convex URLs there)
#   2. Convex        -> npx convex env set NAME value   (never in a file in the repo)
#   3. n8n (docker)  -> .env            (scripts/generate-secrets.sh creates it)
# Never commit real values. .env and .env.local are git-ignored.

# ---------- 1. Next.js (.env.local) ----------
# Written by `npx convex dev`:
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
# From the Clerk dashboard -> API keys:
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---------- 2. Convex deployment (npx convex env set) ----------
# Clerk Frontend API URL, e.g. https://your-app.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=
# n8n production webhook for request-status events:
N8N_REQUEST_WEBHOOK_URL=http://localhost:5678/webhook/lendloop-request-events
# HMAC_SECRET_CONVEX_TO_N8N and HMAC_SECRET_N8N_TO_CONVEX: same values as below.

# ---------- 3. n8n via docker compose (.env) ----------
N8N_ENCRYPTION_KEY=
# Convex signs outgoing webhooks and the overdue-list response with this:
HMAC_SECRET_CONVEX_TO_N8N=
# n8n signs every call to Convex with this:
HMAC_SECRET_N8N_TO_CONVEX=
# Convex HTTP actions URL (NEXT_PUBLIC_CONVEX_SITE_URL / *.convex.site).
# host.docker.internal reaches a local `npx convex dev` backend from the container.
LENDLOOP_CONVEX_SITE_URL=http://host.docker.internal:3211
LENDLOOP_APP_URL=http://localhost:3000
LENDLOOP_MAIL_API_URL=http://mailpit:8025/api/v1/send
LENDLOOP_MAIL_FROM=notifications@lendloop.local
LENDLOOP_OPS_EMAIL=ops@lendloop.local
# Only needed if Convex is in the cloud and must reach n8n through a tunnel:
# N8N_PUBLIC_WEBHOOK_BASE=https://your-tunnel.example.com/
